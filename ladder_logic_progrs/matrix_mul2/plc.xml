              <type>
                <UINT/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="finished">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="false"/>
              </initialValue>
            </variable>
          </outputVars>
          <localVars>
            <variable name="a">
              <type>
                <UINT/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[
if not finished then
  if k < n and j<n and i<n then
    sum := sum + m0[i*n+k] * m1[k*n+j];
    k := k + 1;

  elsif j < n and i<n then
    m2[i*n+j] := sum;
    sum := 0; 
      
    k := 0;
    j := j + 1;

  elsif i < n then
    j := 0;
    k := 0;
    i := i + 1;

  elsif i >= n then
    finished := true;
  
    sum := 0;
    check_sum := 0;
    
    
    for a := 0 to n*n-1 do
      check_sum := check_sum + m2[a];
    end_for;
    
  end_if;
